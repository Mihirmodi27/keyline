{
  "name": "trykeyline",
  "version": "0.4.0",
  "description": "Keyline keeps your coding agent's UI in your design system, and proves every change in a real browser before it ships. One skill reads your codebase, writes a DESIGN.md in your own token names, then audits and fixes type, colour, layout, depth, motion and product patterns through it, and remembers what you decide is deliberate.",
  "keywords": [
    "design",
    "design-system",
    "ui",
    "typography",
    "accessibility",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "skills"
  ],
  "homepage": "https://github.com/Mihirmodi27/keyline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mihirmodi27/keyline.git"
  },
  "license": "MIT",
  "author": "Mihir Modi (https://modimihir.com)",
  "type": "module",
  "bin": {
    "keyline": "bin/keyline.mjs",
    "trykeyline": "bin/keyline.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./check": "./plugins/keyline/skills/keyline/scripts/check.mjs",
    "./check/*": "./plugins/keyline/skills/keyline/scripts/check/*.mjs",
    "./npm": "./bin/npm.mjs"
  },
  "files": [
    "bin",
    "plugins",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "pretest": "node packages/browser/link.mjs",
    "test": "node --test \"test/**/*.test.mjs\" \"packages/*/test/**/*.test.mjs\""
  }
}
