  "narrative": {
    "northStar": "The Shared Clock",
    "overview": "Tandem's page is a clean product-marketing surface built around one object: a timeline where four teammates' days line up and one hour lights up for all of them. Everything else is set in a single neo-grotesque family on near-white paper, with dark ink and one warm ember accent. Density is moderate; sections are long and calm, and the product visual is the only richly detailed thing on the page.\n\nThe system is restrained by temperament: tinted neutrals, one accent that means \"the chosen time\" or \"act here\", and a small set of state colours that exist only inside the product visual (working, flexible, off, confirmed). It rejects the generic AI-built SaaS page named in PRODUCT.md: the centred eyebrow-headline-subhead stack repeated everywhere, identical icon-over-heading feature cards, gradient blobs, and every section wrapped in a bordered rounded card.",
    "keyCharacteristics": [
      "One family (Inter, with Inter Tight for display), weight and size carry hierarchy.",
      "Ember accent reserved for the best slot, the primary nudge and the plan you are being steered to.",
      "Product visual drawn in HTML and CSS, not a screenshot.",
      "Two dark bands (testimonials, final call to action) for pacing.",
      "Pill-shaped buttons and chips; larger radii on containers."
    ],
    "rules": [
      {
        "name": "The One Meaning Rule",
        "body": "Ember means \"the chosen time\" or \"act here\". It never decorates.",
        "section": "colors"
      },
      {
        "name": "The Visual-Only Palette Rule",
        "body": "Blue, amber and green belong to the product visual and its echoes (step chips, check marks). They never colour page chrome.",
        "section": "colors"
      },
      {
        "name": "The Tabular Time Rule",
        "body": "Every hour, offset and price is set with tabular numerals so columns of time line up.",
        "section": "typography"
      },
      {
        "name": "The Only-What-Floats Rule",
        "body": "A shadow says \"this sits above the page\". Only the app window, the suggestion card and the featured plan float.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reserve ember (#ff6a3d) for the chosen hour, the primary nudge and the recommended plan.",
      "**Do** let the overlap timeline carry the explanation; keep copy beside it short and specific.",
      "**Do** use tabular numerals for every time, offset and price.",
      "**Do** meet WCAG 2.2 AA: 4.5:1 for body text, 3:1 for large text and focus rings.",
      "**Do** honour `prefers-reduced-motion`."
    ],
    "donts": [
      "**Don't** build the generic AI-built SaaS page: a centred eyebrow-headline-subhead stack in every section, identical icon-over-heading feature cards, soft gradient blobs, every section wrapped in a bordered rounded card.",
      "**Don't** use the hero-metric template (big number, small label, gradient accent).",
      "**Don't** loop decorative motion (floating cards, pulsing dots).",
      "**Don't** use glassmorphism as decoration.",
      "**Don't** use `border-left` or `border-right` over 1px as a coloured stripe, or gradient text.",
      "**Don't** use em dashes in copy."
    ]
  }
